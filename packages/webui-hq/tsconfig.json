{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    // Repo-wide safety flags from tsconfig.base.json. This package cannot
    // extend that file (bundler/JSX resolution differs), so the flags are
    // mirrored here deliberately — without them the UI packages were the only
    // ones in the workspace where an out-of-range index silently typed as the
    // element type.
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "exactOptionalPropertyTypes": false,
    "noUncheckedSideEffectImports": false,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*"],
  // This package keeps its tests beside the code in `src/**/__tests__/`, so an
  // unqualified `src/**/*` pulled them into the PRODUCTION project as well as
  // `tsconfig.test.json` — the only four test files in the repo owned by two
  // TypeScript projects (architecture health: "included in more than one
  // package TypeScript project"). Test ownership belongs to tsconfig.test.json,
  // which declares its own `exclude` and so does not inherit this one.
  "exclude": ["node_modules", "dist", "src/**/__tests__/**"]
}
