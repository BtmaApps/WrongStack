# verify-deps-before-run is configured as `verifyDepsBeforeRun: false` in
# pnpm-workspace.yaml (2026-09-19 — full rationale there). NOTE: pnpm 12
# ignores pnpm settings in this file; `pnpm config get` returns `undefined`
# for both the `verify-deps-before-run` line below and `script-shell` above
# even while they are present here. They are kept only for older pnpm.
verify-deps-before-run=false

# pnpm 11.x on Windows uses `cmd.exe` by default, which doesn't treat `;`
# as a shell separator. pnpm wraps every script with `; echo "EXIT=$?"`,
# so on cmd.exe the wrapper is passed as args to the program. Pointing
# pnpm at bash fixes the wrapper parsing without touching the scripts.
script-shell=bash
